{
  "name": "anymodel-usage",
  "version": "1.0.1",
  "private": true,
  "description": "AnyModel prepaid balance as an OpenChamber usage provider.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.0"
    },
    "contributes": {
      "panel": {
        "id": "anymodel-usage",
        "name": "AnyModel",
        "icon": "icon.svg"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "quota"
        ]
      },
      "quota": {
        "providers": [
          "anymodel"
        ]
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.8.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
